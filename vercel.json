{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,
  "regions": ["fra1"],
  "redirects": [
    { "source": "/", "has": [{ "type": "host", "value": "aqar-factory-property.vercel.app" }], "destination": "https://www.aqar-factory.com/", "permanent": true },
    { "source": "/:path*", "has": [{ "type": "host", "value": "aqar-factory-property.vercel.app" }], "destination": "https://www.aqar-factory.com/:path*", "permanent": true },
    { "source": "/projects", "destination": "/projects.html", "permanent": true },
    { "source": "/ar/projects", "destination": "/ar/projects.html", "permanent": true },
    { "source": "/units", "destination": "/units.html", "permanent": true },
    { "source": "/ar/units", "destination": "/ar/units.html", "permanent": true },
    { "source": "/cities", "destination": "/cities.html", "permanent": true },
    { "source": "/ar/cities", "destination": "/ar/cities.html", "permanent": true },
    { "source": "/blog", "destination": "/blog.html", "permanent": true },
    { "source": "/ar/blog", "destination": "/ar/blog.html", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/ar/about", "destination": "/ar/about.html", "permanent": true },
    { "source": "/contact", "destination": "/contact.html", "permanent": true },
    { "source": "/ar/contact", "destination": "/ar/contact.html", "permanent": true }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/robots.txt", "destination": "/api/robots" },
    { "source": "/project/:slug", "destination": "/project.html?id=:slug" },
    { "source": "/unit/:slug", "destination": "/unit.html?id=:slug" },
    { "source": "/blog/:slug", "destination": "/blog-post.html?slug=:slug" },
    { "source": "/ar/project/:slug", "destination": "/project.html?id=:slug" },
    { "source": "/ar/unit/:slug", "destination": "/unit.html?id=:slug" },
    { "source": "/ar/blog/:slug", "destination": "/blog-post.html?slug=:slug" },
    { "source": "/ar/:path*", "destination": "/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
